{
  "namespace": "server_form",
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "fc_server_form_factory": {
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@fc_ui.long_root",
                  "custom_form": "@fc_ui.custom_root"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§h§u§b§r' - '§l§s§t§r' - '§b§o§a§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "custom_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§m§d§l§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}
