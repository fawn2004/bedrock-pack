{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "mbb:plumwood_tree"
    },
    "acacia_trunk": {
      "trunk_width": 1,
      "trunk_height": {
        "base": 5,
        "intervals": [
          2
        ],
        "min_height_for_canopy": 3
      },
      "trunk_lean": {
        "allow_diagonal_growth": true,
        "lean_height": {
          "range_min": 2,
          "range_max": 3
        },
        "lean_steps": {
          "range_min": 2,
          "range_max": 3
        },
        "lean_length": {
          "range_min": 1,
          "range_max": 2
        }
      },
      "trunk_block": {
        "name": "mbb:plumwood_wood",
        "states": {
          "minecraft:block_face": "up"
        }
      }
    },
    "random_spread_canopy": {
      "canopy_height": 3,
      "canopy_radius": 4,
      "leaf_placement_attempts": 90,
      "leaf_blocks": [
        [
          {
            "name": "minecraft:azalea_leaves_flowered",
            "states": {
              "persistent_bit": true
            }
          },
          3
        ],
        [
          {
            "name": "minecraft:azalea_leaves",
            "states": {
              "persistent_bit": true
            }
          },
          2
        ]
      ]
    },
    "base_block": [
      "minecraft:dirt"
    ],
    "may_grow_on": [
      "minecraft:grass_block",
      "minecraft:dirt",
      "minecraft:coarse_dirt",
      "minecraft:podzol",
      "minecraft:dirt_with_roots",
      "minecraft:moss_block",
      "minecraft:mud",
      "minecraft:mycelium",
      "minecraft:farmland",
      "minecraft:sand",
      "minecraft:red_sand",
      "minecraft:snow"
